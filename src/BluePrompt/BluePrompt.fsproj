<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Str.fs" />
    <Compile Include="Parse.fs" />
    <Compile Include="SkillFile.fs" />
    <Compile Include="Fmt.fs" />
    <Compile Include="Article.fs" />
    <Compile Include="Html.fs" />
    <Compile Include="Grid.fs" />
    <Compile Include="Listing.fs" />
    <Compile Include="MarkdownWriter.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="Template.fs" />
    <Compile Include="JsonCodec.fs" />
    <Compile Include="WikiruDom.fs" />
    <Compile Include="Appellation.fs" />
    <Compile Include="School.fs" />
    <Compile Include="CharacterList.fs" />
    <Compile Include="Character.fs" />
    <Compile Include="CharacterReader.fs" />
    <Compile Include="CharacterWriter.fs" />
    <Compile Include="Page.fs" />
    <Compile Include="Wikiru.fs" />
    <Compile Include="OpenWebuiJson.fs" />
    <Compile Include="OpenWebui.fs" />
    <Compile Include="OpenWebuiKnowledge.fs" />
    <Compile Include="OpenWebuiSync.fs" />
    <Compile Include="RolePlay.fs" />
    <Compile Include="Target.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.11.0" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Polly.Core" Version="8.9.1" />
    <PackageReference Include="XParsec" Version="1.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
