<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SkillFile.fs" />
    <Compile Include="Fmt.fs" />
    <Compile Include="Pandoc.fs" />
    <Compile Include="Table.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="Template.fs" />
    <Compile Include="Extract.fs" />
    <Compile Include="Appellation.fs" />
    <Compile Include="School.fs" />
    <Compile Include="Page.fs" />
    <Compile Include="Scrape.fs" />
    <Compile Include="Wikiru.fs" />
    <Compile Include="OpenWebui.fs" />
    <Compile Include="OpenWebuiKnowledge.fs" />
    <Compile Include="OpenWebuiSync.fs" />
    <Compile Include="RolePlay.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
  </ItemGroup>
</Project>
