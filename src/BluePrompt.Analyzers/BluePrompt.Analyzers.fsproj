<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Directory.Build.propsで定義する共有プロパティ。値の変更はそちらで行う。 -->
    <TargetFramework>$(BluePromptAnalyzersTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EditorServiceAnalyzer.fs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      バージョンはfsharp-analyzers CLI(flake.nixで供給)と一致させる必要がある。
      アナライザーはCLIホストが読み込んだSDKとFSharp.Compiler.Serviceで実行されるため、
      実行時アセンブリは出力へコピーしない。
    -->
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.39.2" ExcludeAssets="runtime" />
    <!--
      FSharp.CoreはFSharp.Analyzers.SDKとFSharp.Compiler.Serviceが完全一致で要求する版に従う。
      版そのものはDirectory.Build.propsのFSharpCoreVersionで全プロジェクト共通に固定しているので、
      ここでは共通の参照へ完全一致の範囲指定と、
      実行時アセンブリを出力へコピーしない指定だけを上書きする。
    -->
    <PackageReference
      Update="FSharp.Core"
      Version="[$(FSharpCoreVersion)]"
      ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
