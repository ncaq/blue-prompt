<Project>
  <!--
    アナライザーのフラグはNuGetのnuget.g.props($(Pkg...)変数の定義元)より後に
    評価される必要があるため、Directory.Build.propsではなくこちらに置く。
    プロパティの値は実行コマンドへそのまま埋め込まれるため、
    途中で改行すると壊れる。1行で書く必要がある。
  -->
  <PropertyGroup>
    <!--
      CLIツール本体の`fsharp-analyzers`はNix(flake.nix)で供給する。
      既定の実行コマンド`dotnet fsharp-analyzers`は、
      dotnet CLIのツール解決によってPATH上の`dotnet-fsharp-analyzers`へ解決される。
    -->
    <!-- exclude-filesはobj配下のAssemblyInfo.fsなどの自動生成ソースを解析から除外する。 -->
    <FSharpAnalyzersOtherFlags>--analyzers-path "$(PkgG-Research_FSharp_Analyzers)/analyzers/dotnet/fs" --analyzers-path "$(PkgIonide_Analyzers)/analyzers/dotnet/fs" --analyzers-path "$(MSBuildThisFileDirectory)src/BluePrompt.Analyzers/bin/$(Configuration)/net10.0" --exclude-files "**/obj/**"</FSharpAnalyzersOtherFlags>
  </PropertyGroup>

  <!--
    自作アナライザー(BluePrompt.Analyzers)は解析の実行前にビルドされている必要があるため、
    AnalyzeFSharpProjectの実体のターゲットの前にビルドを差し込む。
  -->
  <Target Name="BuildBluePromptAnalyzers" BeforeTargets="_AnalyzeFSharpProject">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)src/BluePrompt.Analyzers/BluePrompt.Analyzers.fsproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
