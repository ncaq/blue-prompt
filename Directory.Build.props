<Project>
  <!--
    F#アナライザー(リンター)を全F#プロジェクトへ一括導入する。
    実行方法はCLAUDE.mdのリンターの節を参照。
  -->
  <PropertyGroup>
    <!--
      自作アナライザー(BluePrompt.Analyzers)のTargetFramework。
      fsprojのTargetFrameworkとDirectory.Build.targetsのanalyzers-pathの
      出力パスの双方から参照して、二重管理によるパスのずれを防ぐ。
    -->
    <BluePromptAnalyzersTargetFramework>net10.0</BluePromptAnalyzersTargetFramework>
  </PropertyGroup>
  <!--
    FSharp.CoreをSDKの暗黙参照ではなく全プロジェクトで明示的に同じ版へ固定する。

    BluePrompt.AnalyzersはFSharp.Analyzers.SDKとFSharp.Compiler.Serviceの都合で
    FSharp.Coreの版の完全一致を要求される。
    SDKの暗黙参照はSDKのパッチ版ごとに異なる版を束ねていて、
    SDK同梱のlibrary-packs(束ねた版だけを置いたローカルフィード)から復元される。
    nixpkgsのfetch-depsはローカルフィードから復元されたパッケージをdeps.jsonへ書かないため、
    Analyzersの固定した版がたまたまSDKの束ねる版と一致するとdeps.jsonからFSharp.Coreが抜け落ち、
    別のパッチ版のSDKを持つnixpkgsからこのflakeを使う側(dotfilesなど)では、
    サンドボックス内で固定した版を取得できず復元が失敗していた。

    library-packsを復元ソースから外して全プロジェクトで同じ版を明示的に参照すれば、
    FSharp.Coreは常にnuget.orgから取得されてdeps.jsonへ残り、
    ビルドがSDKのパッチ版に依存しなくなる。

    版はFSharp.Analyzers.SDKが完全一致で要求する版に従う。
    単独で上げるとNU1608で復元が失敗するため、Renovateでは更新を無効化している。
    上げる時はFSharp.Analyzers.SDKの更新に合わせて、その依存が要求する版へ揃える。
  -->
  <PropertyGroup>
    <FSharpCoreVersion>10.1.400</FSharpCoreVersion>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- AnalyzeFSharpProjectターゲットを提供するMSBuildアダプタ。 -->
    <PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <!--
      アナライザー本体のルール集。
      GeneratePathPropertyでパッケージパスの$(Pkg...)変数を生成させて、
      Directory.Build.targetsのanalyzers-pathフラグから参照する。
    -->
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="0.25.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers</IncludeAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
    <PackageReference Include="Ionide.Analyzers" Version="0.19.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers</IncludeAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
  </ItemGroup>
</Project>
